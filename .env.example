# Copia este archivo a .env.local para desarrollo. Nunca subas .env.local al repositorio.
# Ninguna variable lleva el prefijo NEXT_PUBLIC_: son solo del servidor.

# Firma los códigos de boleto. En Vercel es obligatoria en Production y en Preview; en local
# (sin VERCEL_ENV), si la dejas vacía, se usa una clave aleatoria por proceso. Genera una con:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
TICKET_SIGNING_SECRET=

# owner/repo en minúsculas. Solo hace falta si despliegas con la CLI de Vercel: con Git,
# /api/health usa VERCEL_GIT_REPO_OWNER y VERCEL_GIT_REPO_SLUG.
OWNER=

# Power-up opcional: clave de Google AI Studio. Sin ella el asistente queda apagado.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
